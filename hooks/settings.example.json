{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/block-destructive-git.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/protect-secrets-files.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-sensitive-git-add.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-wrong-runner.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/warn-public-bind.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-tmux-kill-server.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/pre-commit-lint.sh", "timeout": 30 },
          { "type": "command", "command": "bash ~/.claude/hooks/fix-noclobber-redirect.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/protect-ssh-config.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-subagent-git-mutation.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-token-file-reads.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-subagent-path-escape.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/warn-inplace-edit.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-shell-traps.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/block-edit-without-read.sh", "timeout": 10 },
          { "type": "command", "command": "bash ~/.claude/hooks/protect-ssh-config.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/protect-secrets-files.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-subagent-path-escape.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/block-token-file-reads.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/prettier-on-edit.sh", "timeout": 15 },
          { "type": "command", "command": "bash ~/.claude/hooks/warn-long-file.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-localhost-hardcode.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/warn-field-mismatch.sh", "timeout": 10 },
          { "type": "command", "command": "bash ~/.claude/hooks/env-port-sweep.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-test-mocks.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/verify-proxy-routes.sh", "timeout": 10 },
          { "type": "command", "command": "bash ~/.claude/hooks/xcodegen-stale-check.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/warn-localhost-verify.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/retry-counter.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/verify-before-done.sh", "timeout": 10 },
          { "type": "command", "command": "bash ~/.claude/hooks/verify-visual-edits.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
